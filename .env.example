# Copy this file to .env for local development.
# Never commit .env, credentials, wallet files, tokens, or production URLs.
# This follows the same DB/INIT environment contract as initgroup-members.

# Application
# Render production: set SURVEYONE_LOAD_DOTENV=false and SURVEYONE_ENV=production.
# Render provides PORT itself; its Start Command uses --port $PORT.
SURVEYONE_LOAD_DOTENV=true
APP_NAME=IN-SURVEYONE
LOG_LEVEL=INFO
SURVEYONE_ENV=development
SURVEYONE_HOST=127.0.0.1
SURVEYONE_PORT=8300
# Required in production: the externally reachable HTTPS origin, without a trailing slash.
# Local phone QR test: set SURVEYONE_HOST=0.0.0.0 and use the PC LAN address,
# for example SURVEYONE_BASE_URL=http://192.168.0.20:8300. Add that exact origin
# to INIT_ALLOWED_ORIGINS and allow TCP 8300 through the Windows firewall.
SURVEYONE_BASE_URL=http://127.0.0.1:8300
# Required in production: comma-separated exact HTTPS origins. Wildcards and URL paths are forbidden.
INIT_ALLOWED_ORIGINS=http://127.0.0.1:8300,http://localhost:8300

# Oracle DB: local or cloud
DB_MODE=local

# Local Oracle DB
DB_USER_LOC=
DB_PASSWORD_LOC=
DB_HOST=127.0.0.1
DB_PORT=1521
DB_SERVICE=

# Oracle Cloud DB. DB_MODE=cloud requires user/password/DSN in production.
DB_USER_CLD=
DB_PASSWORD_CLD=
DB_DSN_CLD=
# Required when DB_DSN_CLD is a Wallet TNS alias. Render normally uses /etc/secrets.
DB_WALLET_PATH=
# Required only when the selected Wallet requires a password.
DB_WALLET_PASSWORD=

# thin is recommended. Set a client path only for thick mode.
DB_ORACLE_MODE=thin
DB_CLIENT_PATH=
DB_CONNECT_TIMEOUT=10
DB_RETRY_COUNT=1
DB_RETRY_DELAY=1

# Oracle connection pool
DB_POOL_MIN=1
DB_POOL_MAX=6
DB_POOL_INCREMENT=1
DB_POOL_WAIT_TIMEOUT_MS=30000
DB_POOL_ACQUIRE_WARN_SECONDS=3
DB_CALL_TIMEOUT_MS=60000

# Login session and cookie. Production requires a unique random INIT_SECRET_KEY
# and INIT_COOKIE_SECURE=true. Never reuse an API key as the session secret.
# Local http://127.0.0.1 development must use false (or leave it blank).
# Render HTTPS production must use true.
INIT_SECRET_KEY=
# Optional high-privilege signup key. Use a long random value and manage it as
# a deployment secret. It is compared server-side and is never stored with users.
INIT_ADMIN_KEY=
SURVEYONE_SESSION_COOKIE_NAME=surveyone_session
INIT_SESSION_TTL_SECONDS=28800
INIT_COOKIE_SECURE=false
INIT_COOKIE_SAMESITE=lax

# Public survey and Oracle guest experience. Runtime guest creation is offered
# only when the Oracle pool and required schema objects are healthy.
SURVEYONE_GUEST_PROJECT_TTL_HOURS=24
SURVEYONE_DB_GUEST_MAX_PROJECTS=10
SURVEYONE_DB_GUEST_MAX_QUESTIONS=300
SURVEYONE_DB_GUEST_MAX_RESPONSES=2000
SURVEYONE_PUBLIC_SUBMIT_MAX_BYTES=262144
SURVEYONE_PUBLIC_BODY_MAX_BYTES=524288
SURVEYONE_DELIVERY_BODY_MAX_BYTES=4194304
SURVEYONE_GUEST_BODY_MAX_BYTES=16384
SURVEYONE_AUTH_BODY_MAX_BYTES=16384
SURVEYONE_GUEST_CREATE_RATE_LIMIT=60
SURVEYONE_SIGNUP_RATE_LIMIT=30
SURVEYONE_LOGIN_RATE_LIMIT=30
SURVEYONE_PUBLIC_SUBMIT_RATE_LIMIT=120
SURVEYONE_RATE_LIMIT_WINDOW_SECONDS=60

# Delivery adapters are disabled until explicitly configured.
SURVEYONE_EMAIL_PROVIDER=disabled
SURVEYONE_SMS_PROVIDER=disabled
SURVEYONE_KAKAO_PROVIDER=disabled
SURVEYONE_FAX_PROVIDER=disabled
# Stable encryption/HMAC secret for recipient contacts. Required in production;
# rotating it requires a separately planned contact-data migration.
SURVEYONE_DELIVERY_SECRET=
